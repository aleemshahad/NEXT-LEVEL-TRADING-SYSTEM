//@version=6
indicator("Dynamic High/Low Levels & G-Channel Trend", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=500)

// ═════════════════════════════════════════════════════════════════════════════
// INPUTS: Dynamic High/Low Levels
// ═════════════════════════════════════════════════════════════════════════════
grp_calc = "Dynamic HL - Calculations"
lookback = input.int(20, "Lookback Period", minval=1, group=grp_calc)
division_factor = input.float(2.6, "Division Factor", minval=0.1, step=0.1, group=grp_calc)

grp_visual = "Dynamic HL - Visuals"
active_sell_color = input.color(color.new(color.red, 0), "Active Sell Level", group=grp_visual)
active_buy_color = input.color(color.new(color.green, 0), "Active Buy Level", group=grp_visual)
inactive_sell_color = input.color(color.new(color.red, 70), "Inactive Sell Level (Dimmed)", group=grp_visual)
inactive_buy_color = input.color(color.new(color.green, 70), "Inactive Buy Level (Dimmed)", group=grp_visual)
line_width_active = input.int(2, "Active Line Width", minval=1, maxval=4, group=grp_visual)
line_width_inactive = input.int(1, "Inactive Line Width", minval=1, maxval=4, group=grp_visual)
show_price_labels = input.bool(true, "Show Price Labels", group=grp_visual)
show_zones = input.bool(true, "Show Zones", group=grp_visual)

// ═════════════════════════════════════════════════════════════════════════════
// INPUTS: G-Channel Trend Detection
// ═════════════════════════════════════════════════════════════════════════════
grp_gchannel = "G-Channel - Settings"
gLength = input.int(100, "G-Channel Length", group=grp_gchannel)
gSrc = input.source(close, "G-Channel Source", group=grp_gchannel)
showcross = input.bool(true, "Show Buy/Sell Signals", group=grp_gchannel)

// ═════════════════════════════════════════════════════════════════════════════
// CALCULATIONS: Dynamic High/Low Levels
// ═════════════════════════════════════════════════════════════════════════════
currentHigh = ta.highest(high, lookback)
currentLow = ta.lowest(low, lookback)
priceRange = currentHigh - currentLow
dividedRange = priceRange / division_factor

buyLevel = currentLow - dividedRange
sellLevel = currentHigh + dividedRange

var float lastHigh = na
var float lastLow = na
var float lastSellLevel = na
var float lastBuyLevel = na

highChanged = currentHigh != lastHigh
lowChanged = currentLow != lastLow
levelsChanged = highChanged or lowChanged

var float[] histSellLevels = array.new_float(0)
var float[] histBuyLevels = array.new_float(0)
var int[] histBarIndices = array.new_int(0)

// Store historical levels
if levelsChanged and not na(lastSellLevel) and not na(lastBuyLevel)
    array.push(histSellLevels, lastSellLevel)
    array.push(histBuyLevels, lastBuyLevel)
    array.push(histBarIndices, bar_index[1])
    
    // Keep only last 20 historical levels to prevent memory issues
    if array.size(histSellLevels) > 20
        array.shift(histSellLevels)
        array.shift(histBuyLevels)
        array.shift(histBarIndices)

if levelsChanged or barstate.isfirst
    lastHigh := currentHigh
    lastLow := currentLow
    lastSellLevel := sellLevel
    lastBuyLevel := buyLevel

// Draw historical dimmed levels
if barstate.islast
    int histSize = array.size(histSellLevels)
    if histSize > 0
        for i = 0 to histSize - 1
            float histSell = array.get(histSellLevels, i)
            float histBuy = array.get(histBuyLevels, i)
            int startBar = array.get(histBarIndices, i)
            
            line.new(startBar, histSell, bar_index + 20, histSell, color=inactive_sell_color, width=line_width_inactive, style=line.style_dashed, extend=extend.none)
            line.new(startBar, histBuy, bar_index + 20, histBuy, color=inactive_buy_color, width=line_width_inactive, style=line.style_dashed, extend=extend.none)

var line activeSellLine = na
var line activeBuyLine = na
var label sellLabel = na
var label buyLabel = na

// Draw active levels & labels
if barstate.islast
    if not na(activeSellLine)
        line.delete(activeSellLine)
    if not na(activeBuyLine)
        line.delete(activeBuyLine)
    if not na(sellLabel)
        label.delete(sellLabel)
    if not na(buyLabel)
        label.delete(buyLabel)
    
    activeSellLine := line.new(bar_index - lookback, sellLevel, bar_index + 50, sellLevel, color=active_sell_color, width=line_width_active, style=line.style_solid, extend=extend.none)
    activeBuyLine := line.new(bar_index - lookback, buyLevel, bar_index + 50, buyLevel, color=active_buy_color, width=line_width_active, style=line.style_solid, extend=extend.none)
    
    if show_price_labels
        sellLabel := label.new(bar_index + 5, sellLevel, "SELL: " + str.tostring(sellLevel, format.mintick), color=active_sell_color, textcolor=color.white, style=label.style_label_lower_right, size=size.normal)
        buyLabel := label.new(bar_index + 5, buyLevel, "BUY: " + str.tostring(buyLevel, format.mintick), color=active_buy_color, textcolor=color.white, style=label.style_label_upper_right, size=size.normal)

sellUpper = show_zones ? sellLevel : na
sellLower = show_zones ? currentHigh : na
buyUpper = show_zones ? currentLow : na
buyLower = show_zones ? buyLevel : na

p1 = plot(sellUpper, "Sell Upper", color=na)
p2 = plot(sellLower, "Sell Lower", color=na)
fill(p1, p2, color.new(active_sell_color, 90), title="Active Sell Zone")

p3 = plot(buyUpper, "Buy Upper", color=na)
p4 = plot(buyLower, "Buy Lower", color=na)
fill(p3, p4, color.new(active_buy_color, 90), title="Active Buy Zone")

// ═════════════════════════════════════════════════════════════════════════════
// CALCULATIONS: G-Channel Trend Detection
// ═════════════════════════════════════════════════════════════════════════════
var float a = 0.0
var float b = 0.0

a := math.max(gSrc, nz(a[1])) - nz(a[1] - b[1]) / gLength
b := math.min(gSrc, nz(b[1])) + nz(a[1] - b[1]) / gLength
gAvg = math.avg(a, b)

crossup = b[1] < close[1] and b > close
crossdn = a[1] < close[1] and a > close
bullish = ta.barssince(crossdn) <= ta.barssince(crossup)

gColor = bullish ? color.lime : color.red
gColor90 = color.new(gColor, 90)
gColor100 = color.new(gColor, 100)

p1_g = plot(gAvg, "G-Channel Average", color=gColor90, linewidth=1)
p2_g = plot(close, "Close price", color=gColor100, linewidth=1)
fill(p1_g, p2_g, color=gColor90, title="G-Channel Fill")

plotshape(showcross and not bullish and bullish[1] ? gAvg : na, "G-Channel Sell", location=location.absolute, style=shape.labeldown, color=color.red, size=size.tiny, text="Sell", textcolor=color.white, offset=-1)
plotshape(showcross and bullish and not bullish[1] ? gAvg : na, "G-Channel Buy", location=location.absolute, style=shape.labelup, color=color.lime, size=size.tiny, text="Buy", textcolor=color.white, offset=-1)

// ═════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═════════════════════════════════════════════════════════════════════════════
alertcondition(ta.crossover(close, sellLevel), "Sell Level Cross Up", "Price crossed above Sell Level")
alertcondition(ta.crossunder(close, sellLevel), "Sell Level Cross Down", "Price crossed below Sell Level")
alertcondition(ta.crossover(close, buyLevel), "Buy Level Cross Up", "Price crossed above Buy Level")
alertcondition(ta.crossunder(close, buyLevel), "Buy Level Cross Down", "Price crossed below Buy Level")
alertcondition(showcross and bullish and not bullish[1], "G-Channel Buy", "G-Channel changed to Bullish")
alertcondition(showcross and not bullish and bullish[1], "G-Channel Sell", "G-Channel changed to Bearish")

// ═════════════════════════════════════════════════════════════════════════════
// UNIFIED INFO PANEL
// ═════════════════════════════════════════════════════════════════════════════
var table infoPanel = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 80), frame_width=1, frame_color=color.gray)

if barstate.islast
    table.cell(infoPanel, 0, 0, "Current High", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 0, str.tostring(currentHigh, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 0, 1, "Current Low", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 1, str.tostring(currentLow, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 0, 2, "Sell Level", text_color=active_sell_color, text_size=size.small)
    table.cell(infoPanel, 1, 2, str.tostring(sellLevel, format.mintick), text_color=active_sell_color, text_size=size.small)
    table.cell(infoPanel, 0, 3, "Buy Level", text_color=active_buy_color, text_size=size.small)
    table.cell(infoPanel, 1, 3, str.tostring(buyLevel, format.mintick), text_color=active_buy_color, text_size=size.small)
    table.cell(infoPanel, 0, 4, "G-Channel Trend", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 4, bullish ? "BULLISH" : "BEARISH", text_color=gColor, text_size=size.small)